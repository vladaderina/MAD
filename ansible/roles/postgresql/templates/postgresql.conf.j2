#------------------------------------------------------------------------------
# ПОДКЛЮЧЕНИЯ И АУТЕНТИФИКАЦИЯ
#------------------------------------------------------------------------------

# Адреса, на которых PostgreSQL принимает подключения
listen_addresses = '{{ postgresql_listen_addresses }}'
# Порт для подключений
port = {{ postgresql_port }}
# Максимальное количество одновременных подключений
max_connections = 100

#------------------------------------------------------------------------------
# ИСПОЛЬЗОВАНИЕ РЕСУРСОВ (ПАМЯТЬ)
#------------------------------------------------------------------------------

# Размер общей памяти для кэширования данных (25% от RAM)
shared_buffers = {{ postgresql_shared_buffers | default(pg_shared_buffers) }}
# Память для операций сортировки и хэширования
work_mem = {{ postgresql_work_mem | default(pg_work_mem) }}
# Объем кэша файловой системы (75% от RAM)
effective_cache_size = {{ postgresql_effective_cache_size | default(pg_effective_cache_size) }}

#------------------------------------------------------------------------------
# ЖУРНАЛ ПРЕДВАРИТЕЛЬНОЙ ЗАПИСИ (WAL)
#------------------------------------------------------------------------------

# Уровень журналирования WAL
wal_level = {{ postgresql_wal_level }}
# Синхронность записи в WAL
synchronous_commit = {{ postgresql_synchronous_commit }}
# Максимальное количество реплик для отправки WAL
max_wal_senders = {{ postgresql_max_wal_senders }}
# Таймаут между контрольными точками
checkpoint_timeout = {{ postgresql_checkpoint_timeout }}
# Целевое время завершения контрольной точки
checkpoint_completion_target = {{ postgresql_checkpoint_completion_target }}

#------------------------------------------------------------------------------
# РЕПЛИКАЦИЯ
#------------------------------------------------------------------------------

{% if postgresql_synchronous_standby_names != "''" %}
# Имена синхронных реплик
synchronous_standby_names = {{ postgresql_synchronous_standby_names }}
{% endif %}

#------------------------------------------------------------------------------
# ОПТИМИЗАЦИЯ ЗАПРОСОВ
#------------------------------------------------------------------------------

# Стоимость случайного доступа к странице (1.1 для SSD, 4.0 для HDD)
random_page_cost = {{ postgresql_random_page_cost }}
# Уровень параллельного ввода-вывода
effective_io_concurrency = {{ postgresql_effective_io_concurrency }}

#------------------------------------------------------------------------------
# ЛОГИРОВАНИЕ
#------------------------------------------------------------------------------

# Формат строки лога
log_line_prefix = '%m [%p] %q%u@%d '
# Логирование контрольных точек
log_checkpoints = on
# Логирование подключений
log_connections = on
# Логирование отключений
log_disconnections = on
# Логирование ожиданий блокировок
log_lock_waits = on
# Логирование временных файлов
log_temp_files = 0